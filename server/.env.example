# Copy to .env for local development. Production values live in Vercel (project shamar-api).

# Database (Neon Postgres)
NEON_DATABASE_URL=

# Sign-in: the server checks Privy login tokens with these
PRIVY_APP_ID=                # or NEXT_PUBLIC_PRIVY_APP_ID
PRIVY_APP_SECRET=

# Cancellation email (Resend)
RESEND_API_KEY=
RESEND_FROM=SHAMAR <shamar@send.example.com>

# Judgment models (both optional; without them a fixed rule decides)
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
MODEL_TIMEOUT_MS=            # optional, per-call timeout

# Gmail and Calendar (Google OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Where Google sends people back. Production: https://shamar.namite.xyz/api/gmail/callback
# Must also be listed under Authorized redirect URIs in Google Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:3001/gmail/callback

# Telegram bot. Each person links their own chat; there is no shared chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=       # without the @, used to build link-your-Telegram links

# Permission contract on Base
SHAMAR_POLICY_CONTRACT=0xCcdF06aa225864B775de2bCA38403916375B6933
BASE_RPC_URL=                # optional, defaults to https://mainnet.base.org
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
ONCHAIN_AUTH=                # set to off to skip the on-chain check (local testing only)
LOCAL_GRANT_UNTIL=           # optional ISO date; used only when Base can't be read

# Wallet subscription detection (Etherscan v2, Base)
ETHERSCAN_API_KEY=

# Timers: the hourly renewal check and daily reminders must send
# Authorization: Bearer <CRON_SECRET>. Required in production.
CRON_SECRET=

# Safety and testing
DISPATCH_RECIPIENT=          # if set, every cancellation email goes here instead of the merchant
NOTIFY_EMAIL_TO=             # fallback account email for cancellation letters
ALLOW_STAGING=               # true enables /renewals/stage in production (test runs only)

FRONTEND_URL=http://localhost:3000
PORT=3001
